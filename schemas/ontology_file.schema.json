{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://git-graph/schemas/ontology_file.schema.json",
  "title": "Ontology Domain File",
  "description": "Top-level schema for a git-GRAPH domain ontology YAML file.",
  "type": "object",
  "required": ["schema_version", "ontology_version", "domain", "nodes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "ontology_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "domain": { "type": "string" },
    "last_updated": { "type": "string", "format": "date-time" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "ontology_node.schema.json" }
    }
  }
}
