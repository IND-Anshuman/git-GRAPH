{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://git-graph/schemas/patterns_file.schema.json",
  "title": "Patterns File",
  "description": "Top-level schema for a git-GRAPH patterns YAML file containing multiple pattern definitions.",
  "type": "object",
  "required": ["schema_version", "patterns"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": {
      "type": "string",
      "description": "Version of the patterns file schema.",
      "pattern": "^\\d+\\.\\d+$"
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "pattern.schema.json" }
    }
  }
}
